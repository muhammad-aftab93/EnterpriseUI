<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    
    <!-- Open Source Enterprise Package Information -->
    <Company>EnterpriseUI Open Source Foundation</Company>
    <Authors>EnterpriseUI Open Source Contributors</Authors>
    <Product>EnterpriseUI Unified Open Source Component Platform</Product>
    <Copyright>Copyright © 2026 EnterpriseUI Open Source Contributors. Licensed under the Apache License, Version 2.0.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/muhammad-aftab93/EnterpriseUI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/muhammad-aftab93/EnterpriseUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Open-source EnterpriseUI components for .NET. Source code and documentation: https://github.com/muhammad-aftab93/EnterpriseUI</Description>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    
    <!-- Code Quality & Modern .NET Standards -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CS1591;CA1305;CA2007;IL2026;IL2075;IL2060;IL2090;CA1000;CA1816;CA1805</NoWarn>
    
    <!-- Trimming & AOT Preparedness -->
    <IsTrimmable Condition="'$(IsTrimmable)' == ''">true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- Disable packing for samples, tests, and benchmarks so solution-wide `dotnet pack` only packs distributable libraries -->
    <IsPackable Condition="$(MSBuildProjectDirectory.Contains('samples')) Or $(MSBuildProjectDirectory.Contains('tests')) Or $(MSBuildProjectDirectory.Contains('benchmarks'))">false</IsPackable>
  </PropertyGroup>
</Project>
